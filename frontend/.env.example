# Optional environment variables for Cloudflare Pages / Vite

# VPS ML microservice URL (already defaults to this public URL if omitted)
VITE_VPS_URL=https://heladas-api.astrazynk.pp.ua

# C# Clean Architecture Backend URL (optional: if you route a public domain to port 5090)
# VITE_BACKEND_URL=https://mantaro-api.astrazynk.pp.ua

# Cloudflare Pages Build Node version recommendation
NODE_VERSION=20
